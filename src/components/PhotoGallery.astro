---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import breakfast from '../assets/about/bnb-breakfast-winter.webp';
import flower from '../assets/about/flower-051224-polaroid.webp';
import flowerOne from '../assets/about/flower-051224-polaroid-1.webp';
import house from '../assets/about/house.webp';
import img20241125114014 from '../assets/about/img20241125114014.webp';
import moon from '../assets/about/2024-05-13_21-07-50-moon-hdr1.webp';
import prettySky from '../assets/about/2024-05-13_21-08-19-pretty-sky.webp';
import photograph20240518 from '../assets/about/2024-05-18_20-27-18_0001.webp';
import photograph17074098050 from '../assets/about/edriffles-1707409805-0.webp';
import photograph17074098051 from '../assets/about/edriffles-1707409805-1.webp';
import photograph17074135710 from '../assets/about/edriffles-1707413571-0.webp';
import photograph17075365620 from '../assets/about/edriffles-1707536562-0.webp';
import photograph17077937330 from '../assets/about/edriffles-1707793733-0.webp';
import photograph17154567000 from '../assets/about/edriffles-1715456700-0.webp';
import photograph17154570860 from '../assets/about/edriffles-1715457086-0.webp';
import photograph17154870240 from '../assets/about/edriffles-1715487024-0.webp';

const photos = [
	{ src: img20241125114014, alt: 'IMG20241125114014' },
	{ src: flower, alt: 'Flower' },
	{ src: moon, alt: 'Moon' },
	{ src: prettySky, alt: 'Sky' },
	{ src: photograph20240518, alt: 'Photograph' },
	{ src: breakfast, alt: 'Breakfast in winter' },
	{ src: photograph17074098050, alt: 'Photograph' },
	{ src: photograph17074098051, alt: 'Photograph' },
	{ src: photograph17074135710, alt: 'Photograph' },
	{ src: photograph17075365620, alt: 'Photograph' },
	{ src: photograph17077937330, alt: 'Photograph' },
	{ src: photograph17154567000, alt: 'Photograph' },
	{ src: photograph17154570860, alt: 'Photograph' },
	{ src: photograph17154870240, alt: 'Photograph' },
	{ src: flowerOne, alt: 'Flower' },
	{ src: house, alt: 'Sky' },
	...(await getCollection('gallery')).map((photo) => ({
		src: photo.data.image,
		alt: photo.data.alt || 'Image',
	})),
];
---

<section class="photo-index">
	{
		photos.map((photo, index) => (
			<figure>
				<Image
					src={photo.src}
					alt={photo.alt}
					loading={index < 4 ? 'eager' : 'lazy'}
					sizes="(min-width: 1400px) 25vw, (min-width: 851px) 33vw, (min-width: 521px) 50vw, 100vw"
				/>
			</figure>
		))
	}
</section>

<dialog id="photo-viewer" aria-label="Photo viewer">
	<div class="photo-viewer-shell">
		<div class="photo-viewer-titlebar">
			<span class="photo-viewer-title" id="photo-viewer-title"></span>
			<span class="photo-viewer-count" id="photo-viewer-count"></span>
			<button type="button" class="photo-viewer-close" data-viewer-close aria-label="Close">
				&#215;
			</button>
		</div>
		<div class="photo-viewer-stage">
			<Image
				class="photo-viewer-image"
				id="photo-viewer-image"
				src={photos[0].src}
				alt={photos[0].alt}
				loading="eager"
			/>
		</div>
		<div class="photo-viewer-status">
			<button type="button" class="photo-viewer-nav photo-viewer-prev" data-viewer-prev>
				&larr; Prev
			</button>
			<span class="photo-viewer-caption" id="photo-viewer-caption"></span>
			<button type="button" class="photo-viewer-nav photo-viewer-next" data-viewer-next>
				Next &rarr;
			</button>
		</div>
	</div>
</dialog>

<script>
	const gallery = document.querySelectorAll<HTMLImageElement>('.photo-index img');
	const dialog = document.getElementById('photo-viewer') as HTMLDialogElement | null;
	const imageEl = document.getElementById('photo-viewer-image') as HTMLImageElement | null;
	const titleEl = document.getElementById('photo-viewer-title');
	const countEl = document.getElementById('photo-viewer-count');
	const captionEl = document.getElementById('photo-viewer-caption');

	if (dialog && imageEl && titleEl && countEl && captionEl && gallery.length) {
		const photos = Array.from(gallery);
		let currentIndex = 0;

		const show = (index: number) => {
			currentIndex = (index + photos.length) % photos.length;
			const photo = photos[currentIndex];
			imageEl.removeAttribute('srcset');
			imageEl.removeAttribute('sizes');
			imageEl.src = photo.src;
			imageEl.alt = photo.alt;
			titleEl.textContent = photo.alt || 'Photo';
			captionEl.textContent = photo.alt || '';
			countEl.textContent = `${currentIndex + 1} / ${photos.length}`;
		};

		photos.forEach((photo, index) => {
			photo.addEventListener('click', () => {
				show(index);
				dialog.showModal();
			});
		});

		dialog.querySelector('[data-viewer-close]')?.addEventListener('click', () => dialog.close());
		dialog
			.querySelector('[data-viewer-prev]')
			?.addEventListener('click', () => show(currentIndex - 1));
		dialog
			.querySelector('[data-viewer-next]')
			?.addEventListener('click', () => show(currentIndex + 1));

		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(currentIndex - 1);
			if (event.key === 'ArrowRight') show(currentIndex + 1);
		});
	}
</script>
